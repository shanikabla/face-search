# Copy to .env and replace the values: cp .env.example .env
# .env is git-ignored; never commit real secrets.

# User id the Airflow containers run as. On Linux, set it to your own id ($(id -u))
# so the containers can write to ./data; on macOS/Windows the default is fine.
AIRFLOW_UID=50000

# Airflow metadata database
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=airflow

# Application database (images, faces, embeddings)
FACES_DB_USER=faces
FACES_DB_PASSWORD=change-me
FACES_DB_NAME=faces

# Airflow internal secrets (generate with: openssl rand -hex 32)
AIRFLOW_JWT_SECRET=change-me
AIRFLOW_API_SECRET_KEY=change-me
